# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AMPLITUDE_API_KEY=your_amplitude_api_key_here
AMPLITUDE_SECRET_KEY=your_amplitude_secret_key_here

# Meta Marketing API (for automated sync)
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_facebook_app_id_here
META_APP_SECRET=your_facebook_app_secret_here
META_AD_ACCOUNT_ID=act_your_account_id_here

# Amplitude Configuration
AMPLITUDE_SIGNUP_EVENT=user_signup
AMPLITUDE_ACTIVATION_EVENT=course_started
AMPLITUDE_REVENUE_EVENT=payment_completed

# Business Metrics (Cultura Builder)
# Annual subscription fee in BRL
ANNUAL_FEE=2998

# Average discount rate applied to subscriptions
DISCOUNT_RATE=0.30

# Target Customer Acquisition Cost in BRL
TARGET_CAC=400

# Warning threshold for CAC in BRL
MAX_CAC_WARNING=500

# Alert threshold for CAC in BRL
MAX_CAC_ALERT=600

# Target Lifetime Value to Customer Acquisition Cost ratio
TARGET_LTV_CAC_RATIO=3

# Database Configuration (optional - defaults to SQLite)
# DATABASE_URL=sqlite:///cultura_growth.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
